#!/usr/bin/env bash
# post-commit — volontairement NO-OP.
#
# Le bump automatique de version NE se fait plus ici. Il vivait dans ce hook
# post-commit local, mais c'était structurellement inadapté au workflow du repo :
#
#   - `main` n'accepte que des PR (ruleset `pull_request`) → on ne commit
#     jamais directement dessus ;
#   - le squash-merge est exécuté par GitHub côté serveur, où AUCUN hook local ne
#     tourne ;
#   - les PR ouvertes via l'UI GitHub, `gh`, ou Dependabot ne déclenchent aucun
#     hook local non plus.
#
# Résultat : api2 n'était jamais bumpé (aucun commit local ne l'avait touché
# depuis l'ajout de la logique), et le mécanisme dépendait de la discipline.
#
# Le bump est désormais porté par le job `bump-version` de la CI
# (.github/workflows/ci.yml), qui tourne sur chaque PR vers `main` : il détecte
# les briques touchées (app2/app4/api2), bumpe les fichiers de version et committe
# sur la branche de la PR — le bump est donc inclus dans le squash-merge.
# (L'ancien `version-bump.yml`, déclenché sur push `develop`, a été supprimé à la
# consolidation du 2026-09-13 : il n'y a plus de branche `develop`.)
#
# Ce fichier reste présent (câblé via `core.hooksPath`, cf. `make hooks`) pour ne
# pas casser l'installation, mais ne fait plus rien.

exit 0
