#docker\.env.dist

APPLICATION_NAME=kpi

USER_ID=
GROUP_ID=
DOCKER_SUFFIXE_PORT=01

# Images de base : plus lues ici. Versions épinglées dans les Dockerfiles de docker/config/
# (php → Dockerfile.dev.web / Dockerfile.prod.web, frankenphp → Dockerfile.api2,
# mariadb → Dockerfile.db). BASE_IMAGE_PHP / BASE_IMAGE_DB / BASE_IMAGE_FRANKENPHP
# restées dans un docker/.env existant sont ignorées.

# Secret JWT du hub Mercure (>= 32 caracteres). A regenerer par environnement :
#   openssl rand -hex 32
MERCURE_JWT_SECRET=!ChangeThisMercureHubJWTSecretKey!

PHP_CONTAINER_NAME=${APPLICATION_NAME}_php
DB_CONTAINER_NAME=${APPLICATION_NAME}_db
DBWP_CONTAINER_NAME=${APPLICATION_NAME}_dbwp

KPI_DOMAIN_NAME=${APPLICATION_NAME}.localhost
NODE_DOMAIN_NAME=${APPLICATION_NAME}_node.localhost
NODE4_DOMAIN_NAME=${APPLICATION_NAME}_node4.localhost
WSM_DOMAIN_NAME=wsm.kpi.localhost

PHP_INI_FILE=php.ini-development
# PHP_INI_FILE=php.ini-production

HOST_APACHE2_LOG_PATH=./apachelogs/
HOST_NGINX_LOG_PATH=./nginxlogs/

HOST_DB_PATH=./db/mysql/
DB_ROOT_PASSWORD=
DB_USER=
DB_PASSWORD=
DB_NAME=

HOST_DBWP_PATH=./db/mysqlwp/
DBWP_ROOT_PASSWORD=
DBWP_USER=
DBWP_PASSWORD=
DBWP_NAME=

HOST_WORDPRESS_PATH=./wordpress/

# Médias uploadés (logos, photos d'équipes, visuels…), stockés HORS du dépôt Git et montés
# dans kpi / api2 / event-cache-worker à leur emplacement historique (sources/img/...).
# Chemin ABSOLU recommandé (obligatoire avec les worktrees) ; relatif = relatif à docker/.
# Ex. prod : /data/media/kpi — préprod : /data/media/kpi_preprod. Cf. MEDIA_STORAGE.md
HOST_MEDIA_PATH=./media/
# Sauvegarde restic des médias (make media_backup). Le mot de passe est généré au 1er backup :
# le copier dans le gestionnaire de mots de passe, sans lui les sauvegardes sont illisibles.
MEDIA_BACKUP_REPO=/data/backups/kpi/media-restic
MEDIA_BACKUP_PASSWORD_FILE=/data/backups/kpi/.media-restic-password

# Site public (phase 4, FEATURE_CMS.md § 5.4) : secret partagé api2 → app3 pour purger le cache des pages à
# chaque publication. Générer avec `openssl rand -hex 32`. Vide = pas de purge (le cache expire seul en 60 s).
APP3_PURGE_TOKEN=
# Base WordPress lue par `bin/console app:import-wordpress` (reprise des contenus, FEATURE_CMS.md § 8).
# Ex. : mysql://user:motdepasse@kpi_dbwp:3306/wordpress?serverVersion=11.5.2-MariaDB&charset=utf8mb4
WORDPRESS_DATABASE_URL=

# Documents PDF (DOC/specs/PDF_GOTENBERG.md) — À DÉFINIR AVANT `docker compose up`, sinon refus explicite.
# Mot de passe de l'API du conteneur Gotenberg de la stack (basic auth, défense en profondeur) :
#   openssl rand -hex 24
GOTENBERG_USER=gotenberg
GOTENBERG_PASSWORD=ChangeThisGotenbergPassword
# Secret HMAC des liens signés des PDF admin, partagé par api2 et le legacy (kpi) : >= 32 caractères,
# différent par environnement. Le changer invalide seulement les liens en cours (validité 5 min).
#   openssl rand -hex 32
PDF_LINK_SECRET=ChangeThisPdfLinkSecretOfAtLeast32Chars

SMTP_PASSWORD=
