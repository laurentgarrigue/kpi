#docker\.env.dist

APPLICATION_NAME=kpi

USER_ID=
GROUP_ID=
DOCKER_SUFFIXE_PORT=01

# PHP 8.4 is now the standard across all environments (dev, preprod, prod)
BASE_IMAGE_PHP=php:8.4.13-apache-trixie
# Image FrankenPHP pour le conteneur api2 (Symfony worker + hub Mercure)
# BASE_IMAGE_FRANKENPHP : supprimée — version épinglée dans docker/config/Dockerfile.api2
# Secret JWT du hub Mercure (>= 32 caracteres). A regenerer par environnement :
#   openssl rand -hex 32
MERCURE_JWT_SECRET=!ChangeThisMercureHubJWTSecretKey!
# Legacy: php:7.4.33-apache-bullseye (deprecated, migration completed Nov 2025)

# BASE_IMAGE_DB=mariadb:10.4.34
BASE_IMAGE_DB=mariadb:11.5.2

PHP_CONTAINER_NAME=${APPLICATION_NAME}_php
DB_CONTAINER_NAME=${APPLICATION_NAME}_db
DBWP_CONTAINER_NAME=${APPLICATION_NAME}_dbwp

KPI_DOMAIN_NAME=${APPLICATION_NAME}.localhost
NODE_DOMAIN_NAME=${APPLICATION_NAME}_node.localhost
NODE4_DOMAIN_NAME=${APPLICATION_NAME}_node4.localhost
WSM_DOMAIN_NAME=wsm.kpi.localhost

PHP_INI_FILE=php.ini-development
# PHP_INI_FILE=php.ini-production

HOST_APACHE2_LOG_PATH=./apachelogs/
HOST_NGINX_LOG_PATH=./nginxlogs/

HOST_DB_PATH=./db/mysql/
DB_ROOT_PASSWORD=
DB_USER=
DB_PASSWORD=
DB_NAME=

HOST_DBWP_PATH=./db/mysqlwp/
DBWP_ROOT_PASSWORD=
DBWP_USER=
DBWP_PASSWORD=
DBWP_NAME=

HOST_WORDPRESS_PATH=./wordpress/

# Médias uploadés (logos, photos d'équipes, visuels…), stockés HORS du dépôt Git et montés
# dans kpi / api2 / event-cache-worker à leur emplacement historique (sources/img/...).
# Chemin ABSOLU recommandé (obligatoire avec les worktrees) ; relatif = relatif à docker/.
# Ex. prod : /data/media/kpi — préprod : /data/media/kpi_preprod. Cf. MEDIA_STORAGE.md
HOST_MEDIA_PATH=./media/
# Sauvegarde restic des médias (make media_backup). Le mot de passe est généré au 1er backup :
# le copier dans le gestionnaire de mots de passe, sans lui les sauvegardes sont illisibles.
MEDIA_BACKUP_REPO=/data/backups/kpi/media-restic
MEDIA_BACKUP_PASSWORD_FILE=/data/backups/kpi/.media-restic-password

SMTP_PASSWORD=
