ARG USER_ID
ARG GROUP_ID

# Version ÉPINGLÉE ici, dans le dépôt, et non via BASE_IMAGE_PHP dans docker/.env (non
# versionné) : une montée de version passe par une PR, est identique sur tous les
# environnements et part avec le déploiement (cf. PHP2Shell, CVE-2026-109618/109619,
# corrigée en 8.4.27). Garder le même tag dans Dockerfile.dev.web et Dockerfile.prod.web.
FROM php:8.4.27-apache-trixie

# Install required packages and PHP extensions for production
# Includes mPDF dependencies: gd (image processing), zip (file compression)
# Includes Symfony optimization: intl (internationalization)
# Single RUN layer for optimal caching and minimal image size
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y \
    libonig-dev \
    mailutils \
    msmtp \
    gnupg \
    nano \
    libpng-dev \
    libjpeg-dev \
    libfreetype6-dev \
    libzip-dev \
    libicu-dev \
    zip \
    unzip \
    locales \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install pdo pdo_mysql mbstring mysqli gd zip intl \
    && docker-php-ext-enable mysqli \
    && a2enmod headers \
    && a2enmod expires \
    && a2enmod rewrite \
    && a2enmod remoteip \
    && service apache2 restart \
    && sed -i '/fr_FR.UTF-8/s/^# //g' /etc/locale.gen \
    && locale-gen \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /var/run/apache2/apache2.pid \
    && mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
    && apt-get remove -y exim4 exim4-base exim4-config exim4-daemon-light || true \
    && echo "sendmail_path = /usr/bin/msmtp -t" > /usr/local/etc/php/conf.d/sendmail.ini

# Copy PHP auto-prepend configuration for CORS
# Note: auto-prepend-cors.php is in sources/commun/ and will be available via volume mount
COPY php-auto-prepend.ini /usr/local/etc/php/conf.d/

# Copy PHP upload size configuration
COPY php-uploads.ini /usr/local/etc/php/conf.d/

# PHP hardening (PHP2Shell CVE-2026-109618/109619 defence in depth)
COPY php-security.ini /usr/local/etc/php/conf.d/

# Copy Apache vhost configuration with CORS and .htaccess support
COPY 000-default.conf /etc/apache2/sites-enabled/000-default.conf
RUN chmod 644 /etc/apache2/sites-enabled/000-default.conf

# API2 est servi par le conteneur FrankenPHP (${APPLICATION_NAME}_api2), routé par Traefik.
# cf. DOC/developer/reference/FRANKENPHP_MIGRATION_ANALYSIS.md
# Le fichier est conservé (non activé) pour permettre un rollback immédiat :
# réactiver `a2enconf apache-api2` + retirer le service api2 du compose.
COPY apache-api2.conf /etc/apache2/conf-available/
RUN chmod 644 /etc/apache2/conf-available/apache-api2.conf

# Copy Apache mod_remoteip configuration
COPY apache-remoteip.conf /etc/apache2/conf-available/
RUN chmod 644 /etc/apache2/conf-available/apache-remoteip.conf && a2enconf apache-remoteip

# Optional: create a dummy user to avoid 'Failed to get user name for uid 1000'
ARG USER_ID
RUN useradd -u ${USER_ID:-1000} -m dockeruser || true

# Install Composer (multi-stage copy for minimal footprint)
COPY --from=composer:2.10 /usr/bin/composer /usr/bin/composer
