{
	# Traefik termine déjà le TLS : FrankenPHP écoute en HTTP simple sur le réseau interne.
	auto_https off

	# Vraie IP client derrière Traefik (équivalent de mod_remoteip côté Apache).
	servers {
		trusted_proxies static 172.16.0.0/12 127.0.0.1 ::1
	}

	frankenphp {
		# Mode worker : le kernel Symfony reste en mémoire entre les requêtes.
		# Exige runtime/frankenphp-symfony + APP_RUNTIME (cf. compose).
		worker {
			file /app/public/index.php
			num {$FRANKENPHP_NUM_WORKERS:4}
			# ⚠️ Pas de directive `max_requests` dans FrankenPHP 1.x : le garde-fou
			# anti-fuite mémoire se pilote côté PHP via la variable d'env
			# MAX_REQUESTS, lue par runtime/frankenphp-symfony (0 = illimité).
			env MAX_REQUESTS {$FRANKENPHP_MAX_REQUESTS:500}
			# Redémarre le worker quand le code change. Le défaut /app/src ne
			# s'applique QUE si FRANKENPHP_WATCH est absent (cas du dev).
			# ⚠️ Hors dev, la neutralisation passe par FRANKENPHP_WATCH=/watch-disabled
			# (dossier vide de l'image) : une valeur VIDE élargirait le watcher au
			# lieu de l'éteindre. cf. §7.7quater de FRANKENPHP_MIGRATION_ANALYSIS.md
			watch {$FRANKENPHP_WATCH:/app/src}
			max_consecutive_failures 3
		}
	}
}

:80 {
	root * /app/public

	# Hub Mercure natif — évite un conteneur dunglas/mercure dédié.
	# Consommé par la refonte du scoring live (cf. LIVE_MATCH_SCORING_REFACTORING_PROPOSALS §4.6).
	mercure {
		publisher_jwt {$MERCURE_PUBLISHER_JWT_KEY}
		subscriber_jwt {$MERCURE_SUBSCRIBER_JWT_KEY}
		# CORS : mêmes origines que l'API (app2 / app4).
		cors_origins {$MERCURE_CORS_ORIGINS}
		# En dev uniquement : autorise les abonnements anonymes.
		anonymous {$MERCURE_ANONYMOUS:0}
		# Transport persistant : sans lui, le défaut est `local` (buffer mémoire
		# sans historique) et un abonné déconnecté perd définitivement les updates
		# publiés pendant sa coupure — son Last-Event-ID n'a rien à rejouer.
		# bolt écrit les updates sur disque. ⚠️ Le FICHIER survit à un restart, mais
		# pas le point de reprise : après `make api2_restart`, plus aucun rattrapage
		# (mesuré 2026-07-17) — la resync applicative à onopen reste obligatoire.
		# /data doit être inscriptible par ${USER_ID} (le conteneur tourne non-root).
		#
		# ⚠️ Syntaxe : `transport <module> { … }`. L'ancienne forme `transport_url
		# bolt://…?size=N` est REFUSÉE par le hub actuel — il loggue une erreur puis
		# retombe SILENCIEUSEMENT sur le transport `local` : le publish répond 200,
		# mais rien n'est persisté et aucune reprise n'est possible. Vérifier que
		# /data/mercure.db existe après le premier publish (cf. §7.7ter de l'analyse).
		#   size : nombre d'updates conservés ; au-delà, les plus vieux sautent, et
		#          un abonné absent plus longtemps a un trou SILENCIEUX.
		transport bolt {
			path {$MERCURE_TRANSPORT_PATH:/data/mercure.db}
			size {$MERCURE_HISTORY_SIZE:1000}
		}
	}

	encode zstd br gzip

	# Le worker Symfony gère tout ce qui n'est pas un fichier statique.
	php_server

	# Logs d'accès sur stdout, récupérés par le driver json-file de Docker
	# (`make api2_logs`). Il n'y a plus de fichier à lire : rien n'arrive dans
	# docker/apachelogs_8/, qui ne concerne que le legacy Apache.
	#
	# CADDY_ACCESS_LOG_LEVEL pilote le volume :
	#   - ERROR (défaut) : seules les requêtes en échec. Les logs applicatifs et
	#     les erreurs PHP (Monolog → stderr) remontent quand même.
	#   - INFO : toutes les requêtes, une ligne JSON par requête. Très verbeux —
	#     à n'activer que le temps d'un débogage de routage.
	log {
		output stdout
		format json
		level {$CADDY_ACCESS_LOG_LEVEL:ERROR}
	}
}
