# Version ÉPINGLÉE ici, dans le dépôt, et non via BASE_IMAGE_FRANKENPHP dans docker/.env :
# le tag flottant `php8.4` a fait passer la préprod de 1.12.4 à 1.13.0 au détour d'un
# rebuild (2026-10-04), avec deux changements cassants du module Mercure dans le
# Caddyfile (cf. Caddyfile.api2) → api2 en boucle de redémarrage, sans aucun log.
# Monter de version = une PR : changer ce tag, rebuilder en dev, puis valider :
#   docker exec <app>_api2 frankenphp validate --config /etc/frankenphp/Caddyfile
FROM dunglas/frankenphp:1.13.0-php8.4

ARG USER_ID=1000
ARG GROUP_ID=1000

# Extensions requises par API2 (Doctrine + API Platform + intl + gd).
#
# gd (JPEG + PNG) est REQUISE : ImageOperationsService (app4 → Opérations → images)
# redimensionne les logos et photos d'équipe avec imagecreatefromjpeg/png. Sans gd :
# « Attempted to call undefined function imagecreatefromjpeg » (500) à l'upload.
# Elle sert aussi à mPDF (images non triviales) et lève la contrainte ext-gd de
# mpdf/composer.json, cf. §8quinquies de DOC/developer/reference/FRANKENPHP_MIGRATION_ANALYSIS.md.
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y \
        libicu-dev \
        libzip-dev \
        libjpeg62-turbo-dev \
        libpng-dev \
        libcap2-bin \
        locales \
        unzip \
        git \
        msmtp \
    && docker-php-ext-configure gd --with-jpeg \
    && docker-php-ext-install pdo pdo_mysql intl zip gd \
    && sed -i '/fr_FR.UTF-8/s/^# //g' /etc/locale.gen \
    && locale-gen \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Envoi de mails (MAILER_DSN=native://default en préprod/prod → sendmail_path).
# L'image FrankenPHP n'a AUCUN binaire sendmail : sans msmtp, Symfony Mailer échoue
# et NotificationService avale l'exception (mot de passe oublié muet, cf. 2026-10-06).
# Même relais que le conteneur Apache : /etc/msmtprc de l'hôte, monté par compose.
# En dev, MAILER_DSN=smtp://mailpit:1025 : ce réglage n'est pas utilisé.
RUN echo "sendmail_path = /usr/bin/msmtp -t" > /usr/local/etc/php/conf.d/sendmail.ini

# Opcache : indispensable en mode worker.
# validate_timestamps est piloté par environnement (0 en prod, 1 en dev) : voir
# docker/config/opcache-api2-dev.ini monté en volume par compose.dev.yaml.
RUN { \
        echo "opcache.enable=1"; \
        echo "opcache.memory_consumption=256"; \
        echo "opcache.max_accelerated_files=20000"; \
        echo "opcache.validate_timestamps=0"; \
    } > /usr/local/etc/php/conf.d/opcache-worker.ini

# Logging des erreurs PHP vers stderr → `make api2_logs`.
# L'image FrankenPHP a log_errors=Off par défaut : sans ce fichier, une fatale
# PHP dans le worker ne serait loggée nulle part.
COPY php-error-logging-api2.ini /usr/local/etc/php/conf.d/

COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# ⚠️ L'image dunglas/frankenphp lit /etc/frankenphp/Caddyfile, PAS /etc/caddy/Caddyfile.
# Copier au mauvais endroit ne produit AUCUNE erreur : le Caddyfile par défaut de
# l'image prend le relais et le worker ne démarre jamais (max_requests=0 dans les logs).
COPY Caddyfile.api2 /etc/frankenphp/Caddyfile

# Dossier sentinelle pour NEUTRALISER le watcher hors dev (cf. FRANKENPHP_WATCH
# dans compose.preprod/prod.yaml). Il doit être vide et EXISTER :
#   - `FRANKENPHP_WATCH=` (vide) ne désactive pas le watcher : Caddy reçoit une
#     valeur vide et FrankenPHP applique son propre défaut `./**/*.{env,php,…}`,
#     qui balaie tout /app — var/cache/ compris.
#   - un chemin INEXISTANT fait boucler le watcher ("watcher was closed
#     prematurely, retrying...").
# Un dossier vide et existant : le watcher démarre proprement et n'a rien à voir.
RUN mkdir -p /watch-disabled

# FrankenPHP tourne en non-root (user: ${USER_ID} côté compose) mais Caddy doit
# pouvoir binder le port 80, qui est privilégié. Sans ce setcap, le conteneur
# démarre puis meurt sur "permission denied" au bind.
RUN setcap CAP_NET_BIND_SERVICE=+eip /usr/local/bin/frankenphp

# Le worker écrit dans var/cache et var/log : ces répertoires doivent appartenir
# à l'UID hôte, sinon EACCES au boot du kernel (cf. déboires app4/.nuxt en root).
RUN mkdir -p /app/var \
    && chown -R ${USER_ID}:${GROUP_ID} /app /data/caddy /config/caddy 2>/dev/null || true

WORKDIR /app
