# KPI Admin - Environment Configuration
# Copy this file to .env and adjust values for your environment

# Base URL for the application (used for routing)
BASE_URL=/admin2

# API2 Base URL (Symfony API)
API2_BASE_URL=https://kpi.localhost/api2

# Legacy backend Base URL (for PDF documents)
LEGACY_BASE_URL=https://kpi.localhost

# KPI App (app2) Base URL
APP2_BASE_URL=https://app.kpi.localhost

# Public website (app3) for the editorial previews; default: beta.<legacy host>
# PUBLIC_SITE_URL=https://beta.kpi.localhost

# Environment: 'development' | 'preprod' | 'production' (default: auto-detected from NODE_ENV)
# APP_ENV=preprod

# Matomo Analytics, cookie-free (DOC/specs/public/FEATURE_ANALYTICS.md § 4)
# Tracking is on if and only if both values are set; leave them empty in development.
# MATOMO_SITE_ID: 7 (prod), 3 (préprod)
MATOMO_URL=
MATOMO_SITE_ID=
