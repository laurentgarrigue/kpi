# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=f8a6b3c9d2e4a1b7c5d8e9f0a3b6c7d9
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
# ⚠️ Doit inclure le préfixe /api2 (stripprefix Traefik + FrankenPHP) et le domaine
# réel de l'environnement. Sinon les IRI API Platform pointent au mauvais endroit.
DEFAULT_URI=https://kpi.localhost/api2
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="mysql://root:root@kpi_db:3306/kayak_polo?serverVersion=11.5.2-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

# Suppress Doctrine internal deprecations (not from our code)
# This silences the Proxy\Autoloader deprecation from doctrine/doctrine-bundle
DOCTRINE_DEPRECATIONS=0
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1|.*\.localhost)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> API Documentation ###
API_DOCS_SERVER_URL='https://kpi.localhost/api2'
API_DOCS_SERVER_DESCRIPTION='Development server'
###< API Documentation ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=your_jwt_passphrase_here
JWT_TTL=86400
###< lexik/jwt-authentication-bundle ###

###> symfony/mailer ###
MAILER_DSN=native://default
MAILER_FROM='KPI DEV<contact@kayak-polo.info>'
MAILER_ADMIN_TO=contact@kayak-polo.info
APP4_URL=https://kpi-node4.localhost
###< symfony/mailer ###

###> FFCK PCE Import ###
FFCK_PCE_URL=''
FFCK_PCE_USER=''
FFCK_PCE_PWD=''
###< FFCK PCE Import ###

###> Surclassement rules ###
# Competitions requiring age overclassing (surclassement), comma-separated
SURCLASSEMENT_COMPETITIONS='N1D,N1F,N1H,N2,N2H,N3H,N3,N4H,N4,NQH,CFF,CFH,CFD'
# Categories exempt from surclassement requirement (old enough to compete freely), comma-separated
SURCLASSEMENT_EXEMPT_CATEGORIES='JUN,SEN,V1,V2,V3,V4'
###< Surclassement rules ###

###> symfony/mercure-bundle ###
# See https://symfony.com/doc/current/mercure.html#configuration
# Hub Mercure natif de FrankenPHP (cf. docker/config/Caddyfile.api2).
#
# MERCURE_URL : utilisé par Symfony pour PUBLIER. Le hub tourne dans le même
# conteneur, donc on tape en direct en HTTP local — on évite l'aller-retour par
# Traefik (et son certificat auto-signé en dev).
MERCURE_URL=http://localhost/.well-known/mercure
# MERCURE_PUBLIC_URL : renvoyé au navigateur pour S'ABONNER. Doit passer par
# Traefik, donc inclure le préfixe /api2 (stripprefix).
MERCURE_PUBLIC_URL=https://kpi.localhost/api2/.well-known/mercure
# Doit être IDENTIQUE à MERCURE_JWT_SECRET de docker/.env : c'est ce secret qui
# signe les JWT que le hub vérifie (publisher_jwt/subscriber_jwt du Caddyfile).
# `make mercure_generate_secret` en génère un. À régénérer par environnement.
MERCURE_JWT_SECRET="!ChangeThisMercureHubJWTSecretKey!"
###< symfony/mercure-bundle ###
