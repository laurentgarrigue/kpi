{# Layout of every PDF page (PDF_GOTENBERG.md § 8): charter of the audience, header band, content. Files are sent with the page, never fetched. #}
<!doctype html>
<html lang="{{ lang }}">
<head>
    <meta charset="utf-8">
    <title>{{ title }}{% if competition is defined %} - {{ competition.title }}{% endif %}</title>
    <link rel="stylesheet" href="{{ tokens_file }}">
    <link rel="stylesheet" href="{{ stylesheet }}">
</head>
<body class="theme-{{ theme }}">
    {% block watermark %}{% endblock %}
    {% block header %}
    {# Visuals of the competition first (banner, else logo), logos of the charter otherwise (§ 8.4.1). #}
    {% if banner %}<div class="pdf-banner"><img src="{{ banner }}" alt=""></div>{% endif %}
    <header class="pdf-header{% if banner %} pdf-header--below-banner{% endif %}">
        {% if logos is not empty %}
            <div class="pdf-header__logos">
                {% for logo in logos %}<img src="{{ logo }}" alt="">{% endfor %}
            </div>
        {% endif %}
        <div class="pdf-header__titles">
            {# The season at the right of the document title; no competition code, the labels suffice. #}
            <div class="pdf-header__line">
                <h1 class="pdf-header__document">{{ title }}</h1>
                {% if season %}<span class="pdf-header__season">{{ season }}</span>{% endif %}
            </div>
            {% if competition is defined %}
                <div class="pdf-header__competition">{{ competition.title }}{% if competition.subtitle %} · {{ competition.subtitle }}{% endif %}</div>
            {% endif %}
        </div>
        {% if competition_logo %}
            <img class="pdf-header__competition-logo" src="{{ competition_logo }}" alt="">
        {% endif %}
        {% if qr_file %}
            <div class="pdf-header__qr">
                <img src="{{ qr_file }}" alt="">
                {{ labels.scan_for_live }}
            </div>
        {% endif %}
    </header>
    {% endblock %}
    <main>
        {% block content %}{% endblock %}
    </main>
</body>
</html>
