{# Gotenberg footer, rendered by Chromium apart from the page: no fonts nor stylesheet, inline style only. #}
<!doctype html>
<html>
<head>
    <style>
        body { margin: 0 10mm; width: 100%; font-family: Arial, sans-serif; font-size: 7pt; }
        .row { display: flex; justify-content: space-between; width: calc(100% - 20mm); }
    </style>
</head>
<body>
    <div class="row">
        <span>{{ title }}{% if competition is defined %} - {{ competition.title }}{% endif %}{% if theme == 'admin' and internal|default(false) %} · {{ labels.internal_document }}{% endif %}</span>
        <span>{{ labels.generated_on }} {{ generated_at|date(lang == 'en' ? 'Y-m-d H:i' : 'd/m/Y H:i', false) }} · {{ labels.page }} <span class="pageNumber"></span> / <span class="totalPages"></span>{% if qr_url %} · {{ qr_url }}{% endif %}</span>
    </div>
</body>
</html>
