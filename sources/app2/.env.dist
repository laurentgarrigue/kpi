# KPI App2 - Environment Configuration
# Copy this file to .env.development, .env.preprod, and .env.production
# Then adjust the values for each environment

# BASE_URL - Leave empty, Traefik handles routing
BASE_URL=

# API2 Base URL (Symfony API)
# Development: https://kpi.localhost/api2
API_BASE_URL=

# Backend Base URL (legacy PHP)
# Development: https://kpi.localhost
BACKEND_BASE_URL=

# Public website (app3), for the explanation page of the match medals
# Development: https://beta.kpi.localhost — Production: https://beta.kayak-polo.info (www after the switch-over)
PUBLIC_SITE_URL=

# Matomo Analytics, cookie-free (DOC/specs/public/FEATURE_ANALYTICS.md § 4)
# Tracking is on if and only if both values are set; leave them empty in development.
# MATOMO_SITE_ID: 6 (prod), 3 (préprod)
MATOMO_URL=
MATOMO_SITE_ID=
