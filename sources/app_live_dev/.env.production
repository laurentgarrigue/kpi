# Context
VUE_APP_TITLE=KPI Live
NODE_ENV=production

# locale
VUE_APP_I18N_LOCALE=en
VUE_APP_I18N_FALLBACK_LOCALE=en

# API
# VUE_APP_BASE_URL = origine du domaine racine : préfixe des assets partagés
# (/live/..., /img/...) situés à la racine KPI, PAS sous /app_live.
# L'app est servie sous /app_live (chemins relatifs via publicPath:'').
VUE_APP_API_BASE_URL=https://kayak-polo.info
VUE_APP_BASE_URL=https://kayak-polo.info

# Intervals
VUE_APP_INTERVAL_GAME=20000
VUE_APP_INTERVAL_SCORE=5000
VUE_APP_INTERVAL_TIME=5000
VUE_APP_INTERVAL_GAMEEVENTSHOW=8000
